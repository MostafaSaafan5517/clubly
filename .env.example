# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# Supabase. For local development, `pnpm supabase start` then `pnpm env:local` writes these
# three into .env.local for you (other lines in the file are kept).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: it bypasses RLS. Use it only in webhook and reconciliation code, never in the browser.
SUPABASE_SECRET_KEY=

# Stripe, test mode only (the app refuses anything but an sk_test_ key).
# Dashboard -> make sure you're in the sandbox -> Developers -> API keys -> Secret key.
STRIPE_SECRET_KEY=
# Signing secret for webhooks. Locally, `pnpm env:stripe` writes the Stripe CLI's secret here;
# in production it's the secret of the Connect webhook endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=

# Vercel Cron sends it as a bearer token to /api/cron/reconcile, which refuses any other caller.
# Locally, `pnpm env:local` generates one. In production, set a long random value in Vercel.
CRON_SECRET=
