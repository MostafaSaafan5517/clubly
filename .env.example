# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# Supabase. Local values: run `pnpm supabase status -o env` after `pnpm supabase start`
# (API_URL, PUBLISHABLE_KEY and SECRET_KEY in its output).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: it bypasses RLS. Use it only in webhook and reconciliation code, never in the browser.
SUPABASE_SECRET_KEY=
